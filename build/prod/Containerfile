FROM node:24.21.0-alpine3.24@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS frontend-builder
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ .
RUN npm run build

FROM golang:1.27.1-alpine3.24@sha256:8a5910f31396cd4d89662f56c68b3ae31d374308270a1c3bd96672ee5ed43414 AS backend-builder
WORKDIR /app
RUN apk add --no-cache gcc musl-dev git

ENV GO111MODULE=on
ENV CGO_ENABLED=1
ENV GOOS=linux

ARG GIT_COMMIT=unknown
ENV GIT_COMMIT=${GIT_COMMIT}

COPY go.mod go.sum ./
RUN go mod download

COPY . .
COPY --from=frontend-builder /app/dist ./frontend/dist

RUN go build -tags sqlite_fts5 -ldflags "-X main.version=${GIT_COMMIT}" -o /app/server ./cmd/server/main.go

FROM alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
WORKDIR /app

ARG GIT_COMMIT=unknown

# git stays: the sync worker clones/pulls the storage repository at runtime.
RUN apk upgrade --no-cache && \
    apk add --no-cache tzdata ca-certificates git sqlite wget

COPY --from=backend-builder /app/server .
COPY --from=backend-builder /app/frontend/dist ./frontend/dist

RUN mkdir -p storage data && \
    adduser -D -u 10001 app && \
    chown -R app:app /app

USER app

LABEL org.opencontainers.image.revision="${GIT_COMMIT}"

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=15s \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/ping || exit 1

CMD ["./server"]
